# Variables de entorno (en Hostinger se cargan desde hPanel → Node.js → Variables de entorno)

# Base de datos MySQL (Hostinger las escribe solo con "setup-website"; host siempre 127.0.0.1)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Acceso al panel /entrar
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=            # texto aleatorio de 32+ caracteres

# Correo de aviso del formulario (opcional; buzón del dominio)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
